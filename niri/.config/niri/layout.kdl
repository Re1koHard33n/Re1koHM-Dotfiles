layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.75
        proportion 1.0     
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        on
        width 2
        active-color "#88C0D0"
        inactive-color "#4C566A"
    }
    border {
        off
    }
    tab-indicator {
        on
        hide-when-single-tab
        gap 2
        width 4
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 10
        active-color "#88C0D0"
        inactive-color "#4C566A"
        urgent-color "#BF616A"
    }
    insert-hint {
        on
    }
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}