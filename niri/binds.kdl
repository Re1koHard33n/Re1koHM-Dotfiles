binds {
    Mod+1 cooldown-ms=60 { focus-workspace 1; }
    Mod+2 cooldown-ms=60 { focus-workspace 2; }
    Mod+3 cooldown-ms=60 { focus-workspace 3; }
    Mod+4 cooldown-ms=60 { focus-workspace 4; }
    Mod+5 cooldown-ms=60 { focus-workspace 5; }
    Mod+6 cooldown-ms=60 { focus-workspace 6; }
    Mod+7 cooldown-ms=60 { focus-workspace 7; }
    Mod+8 cooldown-ms=60 { focus-workspace 8; }
    Mod+9 cooldown-ms=60 { focus-workspace 9; }
    Mod+Alt+1 { focus-monitor "DP-3"; }
    Mod+Alt+2 { focus-monitor "DP-1"; }
    Mod+Ctrl+1 { move-column-to-monitor "DP-3"; }
    Mod+Ctrl+2 { move-column-to-monitor "DP-1"; }
    Mod+Alt+Left cooldown-ms=60 { consume-or-expel-window-left; }
    Mod+Alt+N allow-when-locked=true hotkey-overlay-title="Toggle Night Mode" { spawn "dms" "ipc" "night" "toggle"; }
    Mod+Alt+Right cooldown-ms=60 { consume-or-expel-window-right; }
    Mod+C cooldown-ms=60 { close-window; }
    Mod+Comma hotkey-overlay-title="Toggle Settings" { spawn "dms" "ipc" "settings" "toggle"; }
    Mod+Ctrl+Down cooldown-ms=60 { set-column-width "-10%"; }
    Mod+Ctrl+F cooldown-ms=60 { move-window-to-floating; }
    Mod+Ctrl+Left cooldown-ms=60 { switch-preset-column-width-back; }
    Mod+Ctrl+Right cooldown-ms=60 { switch-preset-column-width; }
    Mod+Ctrl+T cooldown-ms=60 { move-window-to-tiling; }
    Mod+Ctrl+S cooldown-ms=60 { toggle-column-tabbed-display; }
    Mod+Ctrl+Up cooldown-ms=60 { set-column-width "+10%"; }
    Mod+Ctrl+E cooldown-ms=60 { expel-window-from-column; }
    Mod+Ctrl+C cooldown-ms=60 { consume-window-into-column; }
    Mod+D cooldown-ms=60 repeat=false { spawn "nautilus"; }
    Mod+Down cooldown-ms=60 { focus-window-down; }
    Mod+F cooldown-ms=60 { fullscreen-window; }
    Mod+I cooldown-ms=60 repeat=false { spawn "firefox"; }
    Mod+O cooldown-ms=60 repeat=false { toggle-overview; }
    Mod+Left cooldown-ms=60 { focus-column-left; }
    Mod+M hotkey-overlay-title="Toggle Process List" { spawn "dms" "ipc" "processlist" "toggle"; }
    Mod+N hotkey-overlay-title="Toggle Notification Center" { spawn "dms" "ipc" "notifications" "toggle"; }
    Mod+P hotkey-overlay-title="Toggle Notepad" { spawn "dms" "ipc" "notepad" "toggle"; }
    Mod+Right cooldown-ms=60 { focus-column-right; }
    Mod+Shift+1 cooldown-ms=60 { move-column-to-workspace 1; }
    Mod+Shift+2 cooldown-ms=60 { move-column-to-workspace 2; }
    Mod+Shift+3 cooldown-ms=60 { move-column-to-workspace 3; }
    Mod+Shift+4 cooldown-ms=60 { move-column-to-workspace 4; }
    Mod+Shift+5 cooldown-ms=60 { move-column-to-workspace 5; }
    Mod+Shift+6 cooldown-ms=60 { move-column-to-workspace 6; }
    Mod+Shift+7 cooldown-ms=60 { move-column-to-workspace 7; }
    Mod+Shift+8 cooldown-ms=60 { move-column-to-workspace 8; }
    Mod+Shift+9 cooldown-ms=60 { move-column-to-workspace 9; }
    Mod+Shift+C cooldown-ms=60 { center-column; }
    Mod+Shift+Down cooldown-ms=60 { move-window-down; }
    Mod+Shift+F cooldown-ms=60 { focus-floating; }
    Mod+Shift+Left cooldown-ms=60 { move-column-left; }
    Mod+Shift+Right cooldown-ms=60 { move-column-right; }
    Mod+Shift+T cooldown-ms=60 { focus-tiling; }
    Mod+Shift+Up cooldown-ms=60 { move-window-up; }
    Mod+Space hotkey-overlay-title="Toggle Application Launcher" { spawn "dms" "ipc" "spotlight" "toggle"; }
    Mod+T cooldown-ms=60 repeat=false { spawn "alacritty"; }
    Mod+Up cooldown-ms=60 { focus-window-up; }
    Mod+V hotkey-overlay-title="Toggle Clipboard Manager" { spawn "dms" "ipc" "clipboard" "toggle"; }
    Mod+WheelScrollDown cooldown-ms=60 { focus-column-right; }
    Mod+WheelScrollUp cooldown-ms=60 { focus-column-left; }
    Mod+X hotkey-overlay-title="Toggle Power Menu" { spawn "dms" "ipc" "powermenu" "toggle"; }
    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Mod+S { screenshot-screen; }
    Mod+Alt+S { screenshot-window; }
    Super+Alt+L hotkey-overlay-title="Toggle Lock Screen" { spawn "dms" "ipc" "lock" "lock"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "audio" "decrement" "3"; }
    XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "audio" "micmute"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "audio" "mute"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "audio" "increment" "3"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "brightness" "decrement" "5" ""; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "brightness" "increment" "5" ""; }
}
